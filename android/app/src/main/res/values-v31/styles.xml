<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ native splash screen matching Tempo's Frame-0 Midnight Obsidian & Dual-Ring logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tempo_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_tempo_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/tempo_splash_bg</item>
        <item name="android:navigationBarColor">@color/tempo_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
